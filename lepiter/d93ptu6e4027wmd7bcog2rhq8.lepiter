				"code" : "| htmlString doc writer |\nhtmlString := '<nav data-name=\"navbar\" data-StClass=\"LuiNavigationBar\" class=\"navbar\"><div id=\"245827528\" data-name=\"brand\" data-StClass=\"LuiBrand\" class=\"brand\"><a id=\"170781732\" data-name=\"logo\" data-StClass=\"LuiAnchor\" class=\"logo\" target=\"_blank\" href=\"https://www.sailseas.com/Monmouth/\"><img alt=\"Seas logo\" id=\"250079858\" data-name=\"image\" data-StClass=\"LuiImage\" title=\"Seas Monmouth\" class=\"logoImage\" src=\"/files/LcsPrototypeFileLibrary/favicon.png\"/></a><label id=\"107234731\" data-name=\"brandName\" data-StClass=\"LuiLabel\">SEAS Monmouth</label></div><input id=\"menu-toggle\" data-name=\"menuToggle\" data-StClass=\"LuiResponsiveNavigationMenuCheckbox\" class=\"menu-toggle-checkbox\" name=\"1\" type=\"checkbox\"/><input name=\"2\" type=\"hidden\"/><label id=\"142682364\" data-name=\"menuToggleLabel\" data-StClass=\"LuiLabel\" for=\"menu-toggle\" class=\"menu-btn\">&amp;#9776;</label><ul id=\"210860599\" data-name=\"mainMenu\" data-StClass=\"LuiMainMenu\" class=\"nav-links\"><li id=\"228853671\" data-name=\"home\" data-StClass=\"LuiMenuItem\" class=\"nav-item\"><a id=\"36019753\" data-name=\"anchor\" data-StClass=\"LuiAnchor\" href=\"#\">Home</a></li><li id=\"126648334\" data-name=\"servicesMenuItem\" data-StClass=\"LuiDropDownMenuItem\" class=\"nav-item\"><input id=\"238341756\" data-name=\"servicesMenuItemCheckbox\" data-StClass=\"LuiResponsiveNavigationMenuCheckbox\" class=\"submenu-toggle\" name=\"3\" type=\"checkbox\"/><input name=\"4\" type=\"hidden\"/><label id=\"42211829\" data-name=\"servicesMenuItemLabel\" data-StClass=\"LuiLabel\" class=\"arrow-label\" for=\"238341756\">Services</label><ul id=\"41371128\" data-name=\"servicesMenuItemSubmenu\" data-StClass=\"LuiSubmenu\" class=\"submenu\"><li id=\"253859683\" data-name=\"webDesign\" data-StClass=\"LuiMenuItem\" class=\"nav-item\"><a id=\"96554837\" data-name=\"anchor\" data-StClass=\"LuiAnchor\" href=\"#\">Web Design</a